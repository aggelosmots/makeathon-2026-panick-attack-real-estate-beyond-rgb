# Host folder mounted into the containers.
# Put your documents, CSVs, rasters, PDFs, etc. here.
HOST_DATA_DIR=./data

# Container path where the shared folder appears.
CONTAINER_DATA_DIR=/workspace/data

# Web UI port on the host.
UI_PORT=8501

# MCP endpoint port on the host.
MCP_PORT=8000

# Model backend. Use "groq" for hosted inference or "ollama" for local inference.
MODEL_PROVIDER=groq

# Groq hosted model API. Create a key at https://console.groq.com/keys.
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_COMPLETION_TOKENS=512

# Optional local Ollama settings. Start with: docker compose --profile ollama up -d ollama
OLLAMA_PORT=11434
# Examples: qwen3:8b, llama3.1:8b, mistral-nemo
OLLAMA_MODEL=qwen3:8b

# Default: tools may read the shared folder but cannot write to it.
ALLOW_WRITE_TO_DATA=false

# Agent tool-call loop limit.
AGENT_MAX_STEPS=6
