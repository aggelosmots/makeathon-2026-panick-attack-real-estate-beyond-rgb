# Host folder mounted into the containers.
# Put your documents, CSVs, rasters, PDFs, etc. here.
HOST_DATA_DIR=./data

# Container path where the shared folder appears.
CONTAINER_DATA_DIR=/workspace/data

# Web UI port on the host.
UI_PORT=8501

# MCP endpoint port on the host.
MCP_PORT=8000

# Model backend. "huggingface" and "google" are supported.
MODEL_PROVIDER=google

# Hugging Face Inference Providers router. Create a token at https://huggingface.co/settings/tokens.
HF_API_BASE=https://router.huggingface.co/v1
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.5-27B
HF_MAX_COMPLETION_TOKENS=4096

# Google AI Studio (Gemini API) OpenAI-compatible endpoint.
# Create an API key at https://aistudio.google.com/app/apikey.
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Default: tools may read the shared folder but cannot write to it.
ALLOW_WRITE_TO_DATA=false

# Agent tool-call loop limit.
AGENT_MAX_STEPS=20
